# Copy to .env (Windows: copy .env.example .env) and fill in the values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://auspak:auspak_dev_password@localhost:5432/auspak
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# REQUIRED. Random, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Image storage (local disk). Reference images are stored privately and are never served publicly.
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MEDIA_URL=/media

DEFAULT_COUNTRY_CODE=92

# Business contact (public; returned by GET /api/v1/site/contact)
BUSINESS_NAME=Auspak Interior
BUSINESS_WHATSAPP=03003822377
BUSINESS_EMAIL=arrianhbk@gmail.com
BUSINESS_ADDRESS=Main Service Road, Golra Road, opposite G-11/1, Street #1, Islamabad, Pakistan
BUSINESS_FACEBOOK_URL=https://www.facebook.com/share/1coqzjSSu7/?mibextid=wwXIfr

# Notifications. "mock" records the message but sends NOTHING.
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
# To send real email through Gmail set EMAIL_PROVIDER=smtp and use the settings below.
# SMTP_PASSWORD must be a Google *App Password* (not the normal Gmail password). Put it ONLY in your private .env file.
EMAIL_FROM=Auspak Interior <arrianhbk@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=arrianhbk@gmail.com
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
